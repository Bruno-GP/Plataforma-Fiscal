APP_ENV=development
ENVIRONMENT=development
LOG_LEVEL=CRITICAL
API_REQUEST_LOGS=false
ENABLE_STARTUP_SCHEMA_ENSURE=false

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=plataforma_fiscal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/plataforma_fiscal
POSTGRES_DSN=postgresql://postgres:postgres@postgres:5432/plataforma_fiscal
POSTGRES_NFE_DSN=postgresql://postgres:postgres@postgres:5432/plataforma_fiscal
POSTGRES_SPED_DSN=postgresql://postgres:postgres@postgres:5432/plataforma_fiscal
REDIS_URL=redis://redis:6379/0

OPENAI_API_KEY=
AUTH_SECRET_KEY=change-me
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=plataforma_fiscal_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=12
CORS_ALLOW_ORIGINS=http://localhost:5173
CORS_ALLOW_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?$
CORS_ALLOW_CREDENTIALS=true
UPLOAD_MAX_XML_BYTES=5242880
UPLOAD_MAX_TXT_BYTES=20971520
UPLOAD_MAX_TOTAL_BYTES=52428800
