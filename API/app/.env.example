APP_ENV=development
AUTH_SECRET_KEY=change-me
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=plataforma_fiscal_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
